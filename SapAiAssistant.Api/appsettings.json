{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3",
    "TimeoutMinutes": 10,
    "AvailableModels": ["llama3", "gemma4:latest"]
  },
  "Sap": {
    "ServiceLayerBaseUrl": "",
    "CompanyDb": "",
    "UserName": "",
    "Password": "",
    "TimeoutSeconds": 30
  },
  "Prompts": {
    "TemplatesPath": "../prompts"
  },
  "Database": {
    "Path": "sapassistant.db"
  },
  "Embedding": {
    "Model": "nomic-embed-text",
    "BaseUrl": "http://localhost:11434"
  },
  "Rag": {
    "TopK": 3,
    "MinSimilarityScore": 0.65,
    "ChunkSize": 2000,
    "ChunkOverlap": 200
  }
}
